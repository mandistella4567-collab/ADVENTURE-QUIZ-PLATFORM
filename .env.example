# Optional server-side AI reflection. Never add this key to a VITE_* variable.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
API_PORT=8787

# If the API is hosted on another origin, set this to the exact frontend origin.
CORS_ORIGIN=http://localhost:5173

# Set only when the API is hosted on a different origin from the frontend.
# VITE_API_BASE_URL=https://api.example.com
